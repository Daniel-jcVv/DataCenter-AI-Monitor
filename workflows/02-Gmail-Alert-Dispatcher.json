    {
      "parameters": {
        "jsCode": "const results = [];\n\nfor (const item of $input.all()) {\n  const newItem = { ...item.json };\n  const raw = item.json.ai_analysis || '';\n\n  try {\n  const match = raw.match(/\\\\\"text\\\\\":\\\\\"(.*?)\\\\\"/);\n  \n  if (match && match[1]) {\n      let text = match[1];\n      \n      // 1. Convertir saltos de línea literales (\\n) en <br>\n      text = text.replace(/\\\\n/g, '<br>');\n      \n      // 2. ¡NUEVO! Eliminar cualquier barra invertida residual (\\)\n      text = text.replace(/\\\\/g, '');\n      \n      newItem.clean_analysis = text;\n  } else {\n      newItem.clean_analysis = raw; \n  }\n} catch (error) {\n  newItem.clean_analysis = \"Error processing text.\";\n}\n\n  results.push({ json: newItem });\n}\n\nreturn results;"
      },
